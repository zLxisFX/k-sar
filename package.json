{
  "name": "k-sar-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "prepare:assets": "node scripts/copy-map-worker.mjs && node scripts/copy-public-data.mjs",
    "predev": "npm run prepare:assets",
    "prebuild": "npm run prepare:assets",
    "prestart": "npm run prepare:assets",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:domain && npm run test:data",
    "test:domain": "node --test tests/*.test.ts",
    "test:data": "python -m unittest discover -s tests -p test_*.py",
    "benchmark:routing": "node scripts/benchmark-routing.ts",
    "postinstall": "node scripts/copy-map-worker.mjs"
  },
  "dependencies": {
    "geotiff": "3.0.5",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "maplibre-gl": "6.18.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "@types/geojson": "7946.0.16"
  }
}
